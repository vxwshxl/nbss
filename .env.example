# Public base URL — used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Operations inbox at /admin. CHANGE THESE BEFORE DEPLOYING.
NBSS_ADMIN_USER=admin
NBSS_ADMIN_PASS=nbss-kokrajhar

# Signs the /admin session cookie. Optional: it otherwise derives from the two
# values above, which means changing the password also signs everyone out.
# Set it to a long random string to keep sessions across a password rotation.
# NBSS_ADMIN_SECRET=

# Where form submissions are written. Defaults to ./data/submissions.json
# NBSS_DATA=/var/lib/nbss/submissions.json
