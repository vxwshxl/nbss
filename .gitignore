# dependencies
node_modules/
.pnpm-store

# next (apps/web)
.next/
.next-build/
out/
next-env.d.ts
*.tsbuildinfo

# expo (apps/mobile)
.expo/
dist/
web-build/
expo-env.d.ts
# Generated by `expo prebuild` from app.config.ts. Committing them would mean two
# sources of truth for the native config, and the one in git would be the stale one.
apps/mobile/ios/
apps/mobile/android/
.metro-health-check*
*.orig.*

# signing material — never committed, whatever the extension implies
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# runtime data — submissions are per-deployment, never committed
apps/web/data/submissions.json
apps/web/data/*.tmp

# env. One file at the root; apps/*/.env are symlinks to it, created by
# `pnpm env:link`, and a committed symlink to an absent file is worse than none.
.env
.env.local
.env*.local
apps/*/.env

# editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Supabase CLI scratch, not ours
supabase/.temp/
